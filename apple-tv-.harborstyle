# Harbor Style
name: Apple TV+
blurb: Pure black, minimal, cinematic. Frosted edge-to-edge nav, SF Pro feel, white tvOS card rings.
layout: topdock
card: flat
button: flat
font: general-sans
swatch: #000000, #1c1c1e, #ffffff

@tokens
--color-canvas: #000000
--color-surface: #0d0d0d
--color-elevated: #1c1c1e
--color-raised: #2c2c2e
--color-ink: #ffffff
--color-ink-muted: rgba(255,255,255,0.6)
--color-ink-subtle: rgba(255,255,255,0.35)
--color-edge: rgba(255,255,255,0.1)
--color-edge-soft: rgba(255,255,255,0.05)
--color-accent: #ffffff
--color-accent-soft: rgba(255,255,255,0.12)
--color-danger: #ff453a

@css
/* ───────── Apple TV+ for Harbor ───────── */

/* Typography: real SF Pro on Apple platforms, Inter as a faithful substitute elsewhere */
:root {
  --font-display: -apple-system, "SF Pro Display", "SF Pro Text", "Inter", system-ui, sans-serif;
  --font-sans: -apple-system, "SF Pro Text", "Inter", system-ui, sans-serif;
  --font-channel: -apple-system, "SF Pro Text", "Inter", system-ui, sans-serif;
  --poster-radius: 10px;
}
body {
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  letter-spacing: -0.011em;
}
/* NOTE: never force `html, body { background }` opaque. Harbor keeps html/body/#root
   transparent on purpose so the native MPV video window shows through the WebView on
   playback. An opaque body sheet = black screen when you play anything. The pure-black
   canvas is already supplied by --color-canvas (#000000) via the app's own bg-canvas
   element, so the pages stay black without touching body. */
::selection { background: rgba(255,255,255,0.22); }

/* Flatten the floating pill bar into an edge-to-edge frosted-glass nav */
header[class*='fixed'][class*='inset-x'] {
  padding: 0 !important;
  height: 3.25rem !important;
}
header[class*='fixed'][class*='inset-x'] > div[data-tauri-drag-region] {
  border-radius: 0 !important;
  border: none !important;
  background: rgba(0,0,0,0.55) !important;
  -webkit-backdrop-filter: blur(22px) saturate(180%);
  backdrop-filter: blur(22px) saturate(180%);
  box-shadow: none !important;
  padding-inline-start: 2rem !important;
  padding-inline-end: 1.25rem !important;
  height: 100% !important;
}

/* Soft gradient fade beneath the nav, Apple-style */
header[class*='fixed'][class*='inset-x']::after {
  content: '';
  position: absolute;
  inset-inline: 0;
  top: 100%;
  height: 96px;
  background: linear-gradient(to bottom, rgba(0,0,0,0.85) 0%, rgba(0,0,0,0.4) 50%, transparent 100%);
  pointer-events: none;
}

/* Nav links: no pill. Muted by default, brighter on hover */
header[class*='fixed'] button[class*='rounded-full'][class*='px-3'] {
  border-radius: 0 !important;
  font-family: var(--font-sans);
  font-size: 14px !important;
  font-weight: 400 !important;
  color: rgba(255,255,255,0.5) !important;
  height: 100% !important;
}
header[class*='fixed'] button[class*='rounded-full'][class*='px-3']:hover {
  color: rgba(255,255,255,0.85) !important;
}

/* Active item: bold white, no pill, no underline (true Apple TV+) */
header[class*='fixed'] button[class*='rounded-full'][class*='px-3'] > span[class*='rounded-full'] {
  background: transparent !important;
  box-shadow: none !important;
  -webkit-backdrop-filter: none !important;
  backdrop-filter: none !important;
}
header[class*='fixed'] button[aria-current='page'],
header[class*='fixed'] button[aria-selected='true'] {
  color: #fff !important;
  font-weight: 600 !important;
}

/* Replace the default mark with an Apple-style "harbor+" wordmark */
header[class*='fixed'] svg[class*='h-7'] { color: #fff !important; }
header[class*='fixed'] div[data-tauri-drag-region] > button:first-of-type svg {
  display: none !important;
}
header[class*='fixed'] div[data-tauri-drag-region] > button:first-of-type::after {
  content: "harbor+";
  font-family: var(--font-display);
  font-size: 17px;
  font-weight: 600;
  letter-spacing: -0.02em;
  color: #fff;
  line-height: 1;
}
/* hide the divider that followed the old mark */
header[class*='fixed'] div[data-tauri-drag-region] > div[class*='w-px'] {
  display: none !important;
}

/* Remove the gap so content tucks under the transparent nav */
[class*='pt-20'] { padding-top: 0 !important; }
[class*='top-20'] { top: 3.25rem !important; }

/* Cards: hairline border + white focus ring on hover, like tvOS */
.harbor-poster {
  border: 1px solid rgba(255,255,255,0.07);
  transition: transform .45s cubic-bezier(.22,1,.36,1),
              box-shadow .45s cubic-bezier(.22,1,.36,1),
              border-color .3s ease !important;
}
.group:hover .harbor-poster,
.group:focus-visible .harbor-poster {
  border-color: rgba(255,255,255,0.9);
  box-shadow: 0 26px 60px -18px rgba(0,0,0,0.85),
              0 0 0 1px rgba(255,255,255,0.5) !important;
}

/* Shelf titles: bold and tight, Apple display style */
main h3 {
  font-family: var(--font-display);
  font-weight: 600 !important;
  letter-spacing: -0.021em !important;
}

/* Soften secondary surfaces to Apple greys */
.bg-elevated { background: #1c1c1e !important; }
.bg-surface { background: #0d0d0d !important; }

/* Focus ring in Apple white */
:focus-visible { outline-color: rgba(255,255,255,0.7); }

@js
/* ============================================================================
   NAV OVERFLOW: pin the visible nav to the first 6 items (Home, Discover,
   Catalogs, Movies, Shows, Anime) and push everything after Anime (Manga,
   Live TV, Calendar, My Library, Downloads, Addons) into Harbor's OWN native
   "More" dropdown. Same technique as the Netflix theme: cap the OverflowNav
   container width to exactly fit 6 items + More, so Harbor's native overflow
   logic collapses the rest. Keyboard nav, hover, active states and routing all
   stay 100% native — no injected HTML, so the player is untouched.
   ========================================================================== */
(function () {
  var SEL = 'header[class*="z-[60]"]';   /* the fixed TopDock bar */
  var VISIBLE = 6;                       /* Home, Discover, Catalogs, Movies, Shows, Anime */
  var GAP = 2;                           /* OverflowNav gapPx */
  var MIN_W = 120;                       /* below this the nav isn't laid out yet */
  var mo = null, onResize = null, raf = null;

  /* ghost item -> ghost container (ghostRef) -> OverflowNav root (containerRef) */
  function navRoot(header) {
    var g = header.querySelector('[data-ghost-item]');
    return g && g.parentElement ? g.parentElement.parentElement : null;
  }

  /* Idempotent: safe to call any number of times. Returns true once the nav has
     been measured and configured, false while it isn't ready yet. */
  function apply() {
    var header = document.querySelector(SEL);
    if (!header) return false;
    var root = navRoot(header);
    var items = header.querySelectorAll('[data-ghost-item]');
    var more = header.querySelector('[data-ghost-more]');
    if (!root || !items.length || !more) return false;

    /* single-click: drop the window-drag layer over the nav (idempotent) */
    if (root.hasAttribute('data-tauri-drag-region')) root.removeAttribute('data-tauri-drag-region');

    if (items.length <= VISIBLE) {
      if (root.style.flex) { root.style.flex = ''; root.style.maxWidth = ''; root.style.marginInlineEnd = ''; }
      return true;
    }
    var w = 0;
    for (var i = 0; i < VISIBLE; i++) { if (!items[i]) return false; w += items[i].offsetWidth + GAP; }
    w += more.offsetWidth + GAP;
    if (w < MIN_W) return false;         /* not laid out / fonts not ready yet */

    var px = Math.ceil(w) + 'px';
    /* BASIS = width of the 6 items + More (grow:0 so it never fills the bar,
       shrink:1 so it degrades gracefully on tiny windows). */
    var flexVal = '0 1 ' + px;
    if (root.style.flex !== flexVal) root.style.flex = flexVal;
    if (root.style.maxWidth !== px) root.style.maxWidth = px;
    /* Leftover space becomes the gap before the right cluster (Search / Avatar /
       window buttons stay anchored far-right with no overlap). */
    if (root.style.marginInlineEnd !== 'auto') root.style.marginInlineEnd = 'auto';
    return true;
  }

  /* rAF-driven: re-checks on the next frame(s) until the nav is measurable, then stops. */
  function schedule(retries) {
    if (raf) cancelAnimationFrame(raf);
    raf = requestAnimationFrame(function () {
      raf = null;
      if (!apply() && retries > 0) schedule(retries - 1);
    });
  }

  /* Any DOM change (TopDock mount, route change, profile change, nav re-render) re-runs it. */
  mo = new MutationObserver(function () { schedule(10); });
  mo.observe(document.body, { childList: true, subtree: true });

  /* Re-measure once fonts are ready so the very first paint settles at the right width. */
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(function () { schedule(10); }).catch(function () {});
  }

  onResize = function () { schedule(4); };
  window.addEventListener('resize', onResize);

  schedule(180);   /* initial: keep checking each frame until first measurable paint */

  /* clean up if the theme is switched away (avoids orphaned observers) */
  window.__harborThemeCleanup = function () {
    try {
      if (mo) mo.disconnect();
      if (raf) cancelAnimationFrame(raf);
      if (onResize) window.removeEventListener('resize', onResize);
      var h = document.querySelector(SEL), r = h && navRoot(h);
      if (r) { r.style.flex = ''; r.style.maxWidth = ''; r.style.marginInlineEnd = ''; }
    } catch (e) {}
  };
})();
